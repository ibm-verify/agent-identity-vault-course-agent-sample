{
  "info": {
    "name": "IBM Agent Identity UC3 \u2014 synchronized permanent AgentID",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Root-namespace tryout. Obtain subject_token through the configured browser PKCE flow. Run requests in order; check task/credential identity claims before the Vault read. Secrets are local environment values. See repository complete guide."
  },
  "item": [
    {
      "name": "00 - Verify discovery",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{verify_issuer}}/.well-known/openid-configuration"
      }
    },
    {
      "name": "01 - Vault health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{vault_addr}}/v1/sys/health"
      }
    },
    {
      "name": "02 - Agent actor token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{verify_token_url}}",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{actor_client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{actor_client_secret}}",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"actor_token\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token issued\", () => pm.response.to.be.success);",
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const t = pm.response.json().access_token;",
              "  pm.expect(t).to.be.a(\"string\").and.not.empty;",
              "  pm.environment.set(\"actor_token\", t);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Human-context task exchange",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{verify_token_url}}",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "urn:ietf:params:oauth:grant-type:token-exchange",
              "type": "text"
            },
            {
              "key": "subject_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "actor_token",
              "value": "{{actor_token}}",
              "type": "text"
            },
            {
              "key": "actor_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "requested_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{task_client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{task_client_secret}}",
              "type": "text"
            },
            {
              "key": "subject_token",
              "value": "{{subject_token}}",
              "type": "text"
            },
            {
              "key": "authorization_details",
              "value": "[{\"type\": \"urn:ibm:demo:verify:course_credential_task\", \"action\": \"premium_enroll\", \"courseId\": \"PREM-801\", \"reference\": \"postman-demo\"}]",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"task_token\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token issued\", () => pm.response.to.be.success);",
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const t = pm.response.json().access_token;",
              "  pm.expect(t).to.be.a(\"string\").and.not.empty;",
              "  pm.environment.set(\"task_token\", t);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Agent-subject credential exchange",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": "{{verify_token_url}}",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "urn:ietf:params:oauth:grant-type:token-exchange",
              "type": "text"
            },
            {
              "key": "subject_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "actor_token",
              "value": "{{actor_token}}",
              "type": "text"
            },
            {
              "key": "actor_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "requested_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{credential_client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{credential_client_secret}}",
              "type": "text"
            },
            {
              "key": "subject_token",
              "value": "{{task_token}}",
              "type": "text"
            },
            {
              "key": "authorization_details",
              "value": "[{\"type\": \"vault:path_access\", \"path\": \"course-tools/data/premium-enrollment\", \"capabilities\": [\"read\"]}]",
              "type": "text"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"credential_token\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Token issued\", () => pm.response.to.be.success);",
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "  const t = pm.response.json().access_token;",
              "  pm.expect(t).to.be.a(\"string\").and.not.empty;",
              "  pm.environment.set(\"credential_token\", t);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Read credential using Verify JWT",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Vault-Token",
            "value": "{{credential_token}}"
          }
        ],
        "url": "{{vault_addr}}/v1/course-tools/data/premium-enrollment"
      }
    }
  ]
}
