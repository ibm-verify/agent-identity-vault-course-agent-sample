  "schema": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"title\":\"Vault Path Access\",\"type\":\"object\",\"required\":[\"type\",\"path\",\"capabilities\"],\"additionalProperties\":false,\"properties\":{\"type\":{\"const\":\"vault:path_access\"},\"path\":{\"type\":\"string\",\"pattern\":\"^[A-Za-z0-9._/:-]+$\"},\"capabilities\":{\"type\":\"array\",\"uniqueItems\":true,\"items\":{\"type\":\"string\",\"enum\":[\"read\",\"create\",\"update\",\"delete\",\"list\",\"sudo\",\"patch\",\"subscribe\",\"recover\",\"deny\"]}}}}",
