# Web application
PORT=4000
SESSION_SECRET=replace-with-a-long-random-value
BASE_URL=http://localhost:4000

# IBM Verify issuer and browser subject application
VERIFY_ISSUER=https://YOUR_VERIFY_TENANT/oauth2
VERIFY_TOKEN_URL=https://YOUR_VERIFY_TENANT/oauth2/token
WEB_CLIENT_ID=replace-with-authorization-code-client-id
WEB_CLIENT_SECRET=replace-with-authorization-code-client-secret
REDIRECT_URI=http://localhost:4000/callback
WEB_SCOPE=openid profile email

# Course Assistant actor application
# IMPORTANT: this client represents the actor. The actor used by RFC 8693 is
# the identity in the access token minted from this client, not a free-form
# actor name entered during token exchange.
ACTOR_CLIENT_ID=replace-with-course-assistant-actor-client-id
ACTOR_CLIENT_SECRET=replace-with-course-assistant-actor-client-secret
ACTOR_SCOPE=
ACTOR_CLIENT_AUTH_METHOD=client_secret_post

# Permanent registry identity, never an OAuth client ID
VERIFY_AGENT_ID=replace-with-actual-registry-uuid

# Two separately configured exchange applications
TASK_CLIENT_ID=replace-with-task-exchange-client
TASK_CLIENT_SECRET=replace-with-task-exchange-secret
TASK_CLIENT_AUTH_METHOD=client_secret_post
TASK_AUDIENCE=
TASK_SCOPE=
CREDENTIAL_CLIENT_ID=replace-with-credential-exchange-client
CREDENTIAL_CLIENT_SECRET=replace-with-credential-exchange-secret
CREDENTIAL_CLIENT_AUTH_METHOD=client_secret_post
CREDENTIAL_AUDIENCE=
CREDENTIAL_SCOPE=

# Vault native OAuth resource server
VAULT_ADDR=http://127.0.0.1:8200
VAULT_NAMESPACE=
VAULT_SECRET_API_PATH=course-tools/data/premium-enrollment
VAULT_SECRET_FIELD=api_key

# Protected Premium Course API
# The API trusts this independent value. Change only Vault to demonstrate failure.
PREMIUM_API_EXPECTED_KEY=course-premium-demo-key-2026
PREMIUM_API_URL=http://127.0.0.1:4000/api/premium/enroll

# Demo diagnostics. Never enable raw-token logging in a shared environment.
SHOW_SAFE_TOKEN_CLAIMS=true
