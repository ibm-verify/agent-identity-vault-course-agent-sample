# Course Portal
PORT=4000
SESSION_SECRET=replace-with-a-long-random-value
BASE_URL=http://localhost:4000

# IBM Verify issuer and token endpoint
VERIFY_ISSUER=https://YOUR_VERIFY_TENANT/oauth2
VERIFY_TOKEN_URL=https://YOUR_VERIFY_TENANT/oauth2/token

# 1) Subject OIDC application: Course Portal
WEB_CLIENT_ID=replace-with-subject-client-id
WEB_CLIENT_SECRET=replace-with-subject-client-secret
REDIRECT_URI=http://localhost:4000/callback
WEB_SCOPE=openid profile email

# 2) Actor OIDC application: Course Assistant Runtime
ACTOR_CLIENT_ID=replace-with-actor-client-id
ACTOR_CLIENT_SECRET=replace-with-actor-client-secret
ACTOR_SCOPE=
ACTOR_CLIENT_AUTH_METHOD=client_secret_post

# 3) OIDC application with Token Exchange grant: Course Vault Token Exchange
# Configure its access-token Audience in IBM Verify as: vault-course-tools
TOKEN_EXCHANGE_CLIENT_ID=replace-with-token-exchange-client-id
TOKEN_EXCHANGE_CLIENT_SECRET=replace-with-token-exchange-client-secret
TOKEN_EXCHANGE_CLIENT_AUTH_METHOD=client_secret_post
# Normally leave request audience blank because the OIDC app has a configured static audience.
# Populate only if your tenant requires an explicit RFC 8693 audience request parameter.
TOKEN_EXCHANGE_REQUEST_AUDIENCE=
TOKEN_EXCHANGE_REQUESTED_SCOPE=

# Vault native OAuth Resource Server
VAULT_ADDR=http://127.0.0.1:8200
VAULT_NAMESPACE=
VAULT_SECRET_API_PATH=course-tools/data/premium-enrollment
VAULT_SECRET_FIELD=api_key

# Protected Premium Course Tool API
# This independent value is what the downstream API trusts.
PREMIUM_API_EXPECTED_KEY=course-premium-demo-key-2026
PREMIUM_API_URL=http://127.0.0.1:4000/api/premium/enroll

# Safe demo diagnostics only. Full tokens/secrets are never logged.
SHOW_SAFE_TOKEN_CLAIMS=true
